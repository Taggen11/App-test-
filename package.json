{
  "name": "korkortskompis",
  "version": "1.0.0",
  "description": "Spelifierad mobilapp för att plugga till svenskt B-körkort, med AI-coach",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "cap:sync": "cap sync",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "android:build": "cap sync android && cd android && ./gradlew assembleDebug",
    "assets:generate": "npx -y @capacitor/assets@4 generate --android --ios --iconBackgroundColor '#1f6feb' --iconBackgroundColorDark '#1f6feb' --splashBackgroundColor '#1f6feb' --splashBackgroundColorDark '#1f6feb'"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
